#!/bin/sh
# 容器内管理命令
#
#   leigodctl status                  运行状态、网关地址、加速状态
#   leigodctl log [-f]                本镜像脚本的日志
#   leigodctl plugin-log [-f] [daemon|web|upgrade]
#                                     插件自己的日志（默认 web：app 请求、设备识别、加速）
#   leigodctl devices                 局域网里经过本机的设备（ARP 表）
#   leigodctl restart                 重启插件（入口脚本 5 秒内拉起）

PATH=/usr/sbin:/usr/bin:/sbin:/bin
. /opt/leigod/bin/common.sh

yes_no() {
    [ -n "$1" ] && echo "运行中 (pid $(echo $1))" || echo 未运行
}

cmd_status() {
    echo "插件: 版本 $(plugin_version "$(plugin_bin)" || echo ?)，$(plugin_arch)，模式 $(sed -n 's/^mode=//p' "$PLUGIN_CONF_DIR/acc_firewall.ini" 2>/dev/null)"
    echo "  daemon   $(yes_no "$(plugin_pids '-r daemon')")"
    echo "  web      $(yes_no "$(plugin_pids '-r web')")"
    echo "  upgrade  $(yes_no "$(plugin_pids '-r upgrade')")"
    echo "LAN: ${LAN_IF} $(lan_addr)    SN(eth0 MAC): $(cat /sys/class/net/eth0/address 2>/dev/null)"
    echo "局域网设备设置：网关 = $(lan_ip)    DNS = $(lan_ip)"
    echo "加速状态: $(cat /tmp/acc/acc_core_conf.json 2>/dev/null || echo 无)"
    echo "UPnP 通告: $(pgrep -f 'UDP4-RECVFROM:1900' >/dev/null && echo 运行中 || echo 未运行)"
    echo "DNS: $(pidof dnsmasq >/dev/null && echo 运行中 || echo 未运行)"
}

cmd_devices() {
    printf '%-16s %s\n' IP MAC
    awk -v ifc="$LAN_IF" 'NR > 1 && $6 == ifc && $3 == "0x2" {printf "%-16s %s\n", $1, $4}' /proc/net/arp
}

cmd_restart() {
    local pids
    pids=$(plugin_pids)
    [ -n "$pids" ] || { echo "插件未运行"; return; }
    # shellcheck disable=SC2086
    kill -9 $pids && echo "已重启插件（入口脚本 5 秒后重新拉起）"
}

show_log() {
    local f=$1
    shift
    [ -n "$f" ] && [ -f "$f" ] || { echo "没有日志文件 $f" >&2; exit 1; }
    if [ "$1" = "-f" ]; then
        tail -n 100 -F "$f"
    else
        cat "$f"
    fi | sed 's/\x1b\[[0-9;]*m//g'
}

cmd_plugin_log() {
    local follow="" name=web_api a
    for a in "$@"; do
        case "$a" in
            -f) follow=-f ;;
            daemon) name=acc_daemon ;;
            web) name=web_api ;;
            upgrade) name=$(ls "$PLUGIN_LOG_DIR" 2>/dev/null | grep -i upgrade | head -n 1); name=${name%.log} ;;
        esac
    done
    show_log "$PLUGIN_LOG_DIR/${name}.log" $follow
}

load_conf
detect_lan_if

case "$1" in
    status|"")  cmd_status ;;
    log)        shift; show_log "$LEIGOD_LOG_FILE" "$@" ;;
    plugin-log) shift; cmd_plugin_log "$@" ;;
    devices)    cmd_devices ;;
    restart)    cmd_restart ;;
    *)
        sed -n '2,10s/^# \{0,1\}//p' "$0"
        exit 2
        ;;
esac
